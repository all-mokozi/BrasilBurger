@model IEnumerable<Models.Commande>

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mes Commandes - Brasil Burger</title>
    
    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Font -->
    <link href="https://fonts.googleapis.com/css2?family=Itim&display=swap" rel="stylesheet">

    <style>
        :root {
            --primary-color: #0a7d2c;
            --secondary-color: #FFC30F;
            --danger-color: #E94646;
            --bg-color: #f8f9fa;
        }

        body {
            font-family: 'Itim', cursive;
            background-color: var(--bg-color);
            padding: 15px;
            min-height: 100vh;
        }

        .commandes-container {
            max-width: 1400px;
            margin: 0 auto;
            background: white;
            border-radius: 20px;
            box-shadow: 0 5px 20px rgba(0,0,0,0.08);
            overflow: hidden;
        }

        .header-page {
            background: linear-gradient(135deg, var(--primary-color), #2ea155);
            color: white;
            padding: 25px;
        }

        .logo-box {
            background: rgba(255, 255, 255, 0.2);
            color: white;
            padding: 10px 20px;
            border-radius: 10px;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            transition: all 0.3s;
        }

        .logo-box:hover {
            background: rgba(255, 255, 255, 0.3);
            transform: translateY(-2px);
            text-decoration: none;
            color: white;
        }

        h1 {
            font-size: 1.8rem;
            margin: 0;
            color: white;
        }

        /* Badges de statut */
        .status-badge {
            padding: 6px 12px;
            border-radius: 8px;
            font-size: 0.85rem;
            font-weight: bold;
            display: inline-block;
            min-width: 85px;
            text-align: center;
        }

        .en_cours { background: #fff3cd; color: #856404; border: 1px solid #ffc107; }
        .valide { background: #d4edda; color: #155724; border: 1px solid #28a745; }
        .termine { background: #cce5ff; color: #004085; border: 1px solid #007bff; }
        .annule { background: #f8d7da; color: #721c24; border: 1px solid #dc3545; }

        /* Mode tag */
        .mode-tag {
            background: #e9f5ec;
            color: var(--primary-color);
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.9rem;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            white-space: nowrap;
        }

        .ref {
            font-weight: bold;
            color: var(--primary-color);
            font-size: 1.1rem;
        }

        .price {
            font-weight: bold;
            color: #333;
            font-size: 1.1rem;
        }

        .table-responsive {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }

        .table {
            margin-bottom: 0;
        }

        .table th {
            background-color: #f1f8ff;
            border-bottom: 3px solid #dee2e6;
            color: var(--primary-color);
            font-weight: 700;
            padding: 16px 12px;
            white-space: nowrap;
        }

        .table td {
            padding: 16px 12px;
            vertical-align: middle;
            border-color: #eef2f7;
        }

        .table tbody tr {
            transition: all 0.2s;
        }

        .table tbody tr:hover {
            background-color: #f0f9ff;
            transform: translateY(-1px);
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        }

        .empty-state {
            padding: 60px 20px;
            text-align: center;
        }

        .empty-state i {
            font-size: 5rem;
            color: #d1e7dd;
            margin-bottom: 20px;
        }

        .btn-primary-custom {
            background: linear-gradient(135deg, var(--primary-color), #2ea155);
            color: white;
            border: none;
            padding: 12px 30px;
            border-radius: 10px;
            font-weight: 600;
            font-size: 1rem;
            transition: all 0.3s;
        }

        .btn-primary-custom:hover {
            background: linear-gradient(135deg, #086826, #1d8b47);
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(10, 125, 44, 0.25);
        }

        /* Card layout for mobile */
        .commande-card {
            background: white;
            border: 1px solid #e3eaf2;
            border-radius: 12px;
            padding: 20px;
            margin-bottom: 15px;
            box-shadow: 0 3px 10px rgba(0,0,0,0.04);
        }

        .commande-card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
            padding-bottom: 12px;
            border-bottom: 2px solid #f0f4f8;
        }

        .commande-card-body {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 15px;
        }

        .card-item {
            margin-bottom: 10px;
        }

        .card-label {
            font-weight: 600;
            color: var(--primary-color);
            font-size: 0.9rem;
            margin-bottom: 4px;
        }

        .card-value {
            font-size: 1rem;
            color: #333;
        }

        /* Responsive adjustments */
        @@media (max-width: 1199px) {
            .commandes-container {
                border-radius: 15px;
            }
            
            .table th, .table td {
                padding: 14px 10px;
            }
        }

        @@media (max-width: 991px) {
            .header-page {
                padding: 20px;
            }
            
            h1 {
                font-size: 1.6rem;
            }
            
            .table {
                font-size: 0.95rem;
            }
            
            .status-badge, .mode-tag {
                font-size: 0.85rem;
            }
        }

        @@media (max-width: 768px) {
            body {
                padding: 10px;
            }
            
            .commandes-container {
                border-radius: 12px;
            }
            
            .header-page {
                flex-direction: column;
                gap: 15px;
                text-align: center;
                padding: 20px 15px;
            }
            
            .logo-box {
                justify-content: center;
                width: 100%;
                max-width: 300px;
            }
            
            .table-responsive {
                border-radius: 8px;
                border: 1px solid #dee2e6;
            }
            
            /* Hide table, show cards */
            .table {
                display: none;
            }
            
            .commandes-cards {
                display: block;
            }
        }

        @@media (max-width: 576px) {
            .commande-card {
                padding: 15px;
            }
            
            .commande-card-body {
                grid-template-columns: 1fr;
                gap: 12px;
            }
            
            .empty-state {
                padding: 40px 15px;
            }
            
            .empty-state i {
                font-size: 4rem;
            }
            
            .btn-primary-custom {
                width: 100%;
                max-width: 300px;
            }
        }

        @@media (max-width: 425px) {
            .header-page {
                padding: 15px;
            }
            
            h1 {
                font-size: 1.4rem;
            }
            
            .logo-box span {
                font-size: 1.1rem;
            }
            
            .commande-card {
                padding: 12px;
            }
            
            .status-badge {
                padding: 5px 10px;
                font-size: 0.8rem;
                min-width: 75px;
            }
            
            .mode-tag {
                padding: 5px 10px;
                font-size: 0.85rem;
            }
        }

        /* Utility classes */
        .text-truncate-2 {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }
    </style>
</head>
<body>

<div class="commandes-container">
    <!-- Header -->
    <div class="header-page d-flex flex-column flex-md-row justify-content-between align-items-center">
        <a asp-controller="Produit" asp-action="Index" class="logo-box mb-3 mb-md-0">
           Retour
        </a>
        <h1 class="text-center text-md-start mb-0"><i class="fas fa-list-ul me-2"></i>Mon Historique</h1>
    </div>

    <!-- Content -->
    <div class="p-3 p-md-4">
        @if (Model != null && Model.Any())
        {
            <!-- Desktop/Tablet Table View -->
            <div class="table-responsive d-none d-md-block">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th scope="col" class="ps-4">Réf</th>
                            <th scope="col">Date</th>
                            <th scope="col">Produit</th>
                            <th scope="col">Consommation</th>
                            <th scope="col">Total</th>
                            <th scope="col">Statut</th>
                           
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cmd in Model)
                        {
                            @if(cmd.Etat.ToString()=="VALIDE"){
                                 <tr>
                                <td class="ref ps-4">#@cmd.Id</td>
                                <td>@cmd.DateCommande.ToString("dd/MM/yy HH:mm")</td>
                                <td>
                                    <div class="fw-bold">@cmd.Produit?.Nom</div>
                                    <div class="text-muted small">Quantité : @cmd.Quantite</div>
                                </td>
                                <td>
                                    <span class="mode-tag">
                                        <i class="fas fa-@(cmd.ModeC.ToString() == "LIVRAISON" ? "truck" : "store") me-1"></i>
                                        @cmd.ModeC.ToString().Replace("_", " ")
                                    </span>
                                </td>
                                <td class="price fw-bold">@cmd.MontantTotal.ToString("N0") FCFA</td>
                                <td>
                                    <span class="status-badge @cmd.Etat.ToLower()">
                                        @cmd.Etat.Replace("_", " ")
                                    </span>
                                </td>
                              
                            </tr>

                            }
                           
                        }
                    </tbody>
                </table>
            </div>

            <!-- Mobile Card View -->
            <div class="commandes-cards d-md-none">
                @foreach (var cmd in Model)
                {
                    <div class="commande-card">
                        <div class="commande-card-header">
                            <div class="ref">Commande #@cmd.Id</div>
                            <span class="status-badge @cmd.Etat.ToLower()">
                                @cmd.Etat.Replace("_", " ")
                            </span>
                        </div>
                        
                        <div class="commande-card-body">
                            <div class="card-item">
                                <div class="card-label">Date</div>
                                <div class="card-value">@cmd.DateCommande.ToString("dd/MM/yy HH:mm")</div>
                            </div>
                            
                            <div class="card-item">
                                <div class="card-label">Produit</div>
                                <div class="card-value text-truncate-2">@cmd.Produit?.Nom</div>
                                <div class="text-muted small">Quantité : @cmd.Quantite</div>
                            </div>
                            
                            <div class="card-item">
                                <div class="card-label">Consommation</div>
                                <div class="card-value">
                                    <span class="mode-tag">
                                        <i class="fas fa-@(cmd.ModeC.ToString() == "LIVRAISON" ? "truck" : "store") me-1"></i>
                                        @cmd.ModeC.ToString().Replace("_", " ")
                                    </span>
                                </div>
                            </div>
                            
                            <div class="card-item">
                                <div class="card-label">Total</div>
                                <div class="card-value price">@cmd.MontantTotal.ToString("N0") FCFA</div>
                            </div>
                        </div>
                        
                        
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-shopping-basket mb-4"></i>
                <h3 class="text-muted mb-3 fs-4">Aucune commande trouvée</h3>
                <p class="text-muted mb-4 fs-5">Vous n'avez pas encore passé de commande.</p>
                <a asp-controller="Produit" asp-action="Index" class="btn btn-primary-custom">
                    <i class="fas fa-utensils me-2"></i>Consulter le menu
                </a>
            </div>
        }
    </div>
</div>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
    // Animation pour les cartes
    document.addEventListener('DOMContentLoaded', function() {
        // Animate cards on load
        const cards = document.querySelectorAll('.commande-card');
        cards.forEach((card, index) => {
            card.style.opacity = '0';
            card.style.transform = 'translateY(20px)';
            
            setTimeout(() => {
                card.style.transition = 'opacity 0.5s ease, transform 0.5s ease';
                card.style.opacity = '1';
                card.style.transform = 'translateY(0)';
            }, index * 100);
        });
        
        // Update card layout on resize
        function updateLayout() {
            if (window.innerWidth >= 768) {
                document.querySelector('.commandes-cards')?.classList.add('d-none');
                document.querySelector('.table-responsive')?.classList.remove('d-none');
            } else {
                document.querySelector('.commandes-cards')?.classList.remove('d-none');
                document.querySelector('.table-responsive')?.classList.add('d-none');
            }
        }
        
        window.addEventListener('resize', updateLayout);
        updateLayout(); // Initial call
    });
</script>

</body>
</html>