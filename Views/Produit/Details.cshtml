@model Models.Produit

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <title>Détails - @Model.Nom</title>
    <link href="https://fonts.googleapis.com/css2?family=Itim&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/style.css">
</head>

<body>

    <div class="modal">

        <!-- HEADER -->
        <div class="header">
            <div class="logo">
                <img
                    src="~/img/hamburger-junk-food-white-icon-png-image-701751694972500plxqkzef6f-removebg-preview.png">
                <div class="nom">
                    <span style="color:#0c0c0c;">Brasil</span>
                    <span style="color:#FFC30F;">Burger</span>
                </div>
            </div>

            <a asp-action="Index" class="close">✕</a>
        </div>

        <h1>Détails du produit</h1>

        <!-- CONTENT -->
        <div class="content">

            <!-- IMAGE -->
            <div class="image-box">
                <img src="@Model.Image" alt="@Model.Nom">
            </div>

            <!-- DETAILS -->
            <div class="details">
                <div class="gauche">
                    <p><strong>Produit :</strong> @Model.Nom</p>
                    <p><strong>Type :</strong> @Model.TypeProduit</p>

                    <p>
                        <strong>Prix :</strong>
                        <span style="color:#0a7d2c;font-weight:bold;">
                            @Model.Prix FCFA
                        </span>
                    </p>
                       @if (Model.TypeProduit.ToString() == "MENU" 
             && Model.ComposantsDuMenu?.Any() == true)
        {
            <p><strong>Composition du menu :</strong></p>

            <ul>
                @foreach (var composant in Model.ComposantsDuMenu)
                {
                    <li>
                        @composant.ProduitComposant.Nom
                    </li>
                }
            </ul>
        }

                    <p>
                        <strong>Description :</strong><br>
                        @Model.Description
                    </p>
                </div>
            </div>

        </div>

        <!-- FOOTER -->
        <div class="footer">
            <a asp-action="Index" class="btn-commande" style="background:#ccc;color:black;">
                ← Retour
            </a>

            <a asp-action="Commander" asp-route-id="@Model.Id" class="btn-commande ">
                🛒 Commander
            </a>
        </div>

    </div>

</body>

</html>