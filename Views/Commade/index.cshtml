@model Models.Produit

@{
    Layout = null; // Si tu veux garder ton design modal plein écran
}

<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>Commander @Model.Nom</title>
    <link href="https://fonts.googleapis.com/css2?family=Itim&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/style.css">
</head>
<body>

    <form asp-action="ConfirmerCommande" method="post" class="modal">
        <input type="hidden" name="ProduitId" value="@Model.Id" />

        <div class="header">
            <div class="logo">
                <div class="image">
                    <img src="~/images/logo-burger.png">
                </div>
                <div class="nom">
                    <span style="color: black; font-size: 20px;">Brasil</span>
                    <span style="color: #FFC30F; font-weight: 100; font-size: 20px;">Burger</span>
                </div>
            </div>
            <a asp-action="Index" class="close" style="text-decoration:none; color:black;">✕</a>
        </div>

        <h1>Commander maintenant</h1>

        <div class="content">
            <div class="image-box">
                <img src="@Model.Image" alt="@Model.Nom">
            </div>

            <div class="details d-flex">
                <div class="gauche">
                    <p><strong>Produit :</strong> @Model.Nom</p>

                    <div class="quantite">
                        <span>Quantité :</span>
                        <button type="button" class="left" onclick="decrement()">-</button>
                        <span class="qte" id="displayQty">1</span>
                        <button type="button" class="right" onclick="increment()">+</button>
                        <input type="hidden" name="Quantite" id="inputQty" value="1" />
                    </div>

                    <p><strong>Prix :</strong> <span id="unitPrice">@Model.Prix</span> FCFA</p>
                    <p><strong>Total :</strong> <span id="totalPrice" style="color:#0a7d2c; font-weight:bold;">@Model.Prix</span> FCFA</p>

                    <h3>Moyen de paiement</h3>
                    <div class="paiement">
                        <label class="Moyen">
                            <input type="radio" name="MoyenPaiement" value="WAVE" required> 
                            Wave <img src="~/images/wave.png">
                        </label>
                        <label class="Moyen">
                            <input type="radio" name="MoyenPaiement" value="OM" required> 
                            Orange Money <img src="~/images/om.png">
                        </label>
                    </div>
                </div>

                <div class="droite">
                    <div class="mode">
                        <label><input type="radio" name="ModeConsommation" value="SUR_PLACE" checked> Sur place</label>
                        <label><input type="radio" name="ModeConsommation" value="A_EMPORTER"> À emporter</label>
                        <label><input type="radio" name="ModeConsommation" value="LIVRAISON"> À livrer</label>
                    </div>

                    <select name="Complement" class="complement">
                        <option value="">Aucun complément</option>
                        <option value="FRITES">Frites</option>
                        <option value="BOISSON">Boisson</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="footer">
            <button type="submit" class="btn-commande">
                <span>🛒 Commander</span>
            </button>
        </div>
    </form>

    <script>
        let qty = 1;
        const price = @Model.Prix;

        function updateDisplay() {
            document.getElementById('displayQty').innerText = qty;
            document.getElementById('inputQty').value = qty;
            document.getElementById('totalPrice').innerText = qty * price;
        }

        function increment() { qty++; updateDisplay(); }
        function decrement() { if(qty > 1) qty--; updateDisplay(); }
    </script>
</body>
</html>