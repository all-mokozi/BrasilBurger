{% extends 'base.html.twig' %}

{% block title %}Gestion des Commandes
{% endblock %}


{% block body %}


	<div class="container">
		{% include 'components/barLaterale.html.twig' %}


		<main class="main-content">
			<header>
				<h2>DashBoard</h2>
				<div class="user-profile">
					<i class="fa-regular fa-user"></i>
				</div>
			</header>

			<div class="stats-grid">
				<div class="card card-green-border">
					<div class="icon-box green-bg">
						<i class="fa-regular fa-money-bill-1"></i>
					</div>
					<div class="card-info">
						<p>Recette du jour</p>
						<h3>1.004.500 FCFA</h3>
					</div>
				</div>
				<div class="card card-yellow-border">
					<div class="icon-box yellow-bg">
						<i class="fa-regular fa-clock"></i>
					</div>
					<div class="card-info">
						<p>En Cours</p>
						<h3>12</h3>
					</div>
				</div>
				<div class="card card-green-light-border">
					<div class="icon-box light-green-bg">
						<i class="fa-solid fa-check"></i>
					</div>
					<div class="card-info">
						<p>Validee</p>
						<h3>45</h3>
					</div>
				</div>
				<div class="card card-red-border">
					<div class="icon-box red-bg">
						<i class="fa-solid fa-xmark"></i>
					</div>
					<div class="card-info">
						<p>Annulee</p>
						<h3>3</h3>
					</div>
				</div>
			</div>

			<section class="recent-orders">
				<div class="table-header-control">
					<h3>La liste des livreurs</h3>
					<div class="filter-box">
						<a href="#" class="btn-create">
						{# {{ path('app_utilisateur_new') }} #}
    <i class="fa-solid fa-plus"></i>
    Créer un utilisateur
</a>
					</div>
				</div>

				<table class="styled-table">
					<thead>
						<tr>
							<th>Id</th>
							<th>NOM</th>
							<th>telephone</th>
							<th>role</th>
						</tr>
					</thead>
					<tbody>
						{% for utilisateur in utilisateurs %}
							<tr>
								<td>{{ utilisateur.id }}</td>

								<td>{{ utilisateur.nom }}</td>
								
								<td>{{ utilisateur.telephone }}</td>
								<td>{{ utilisateur.role }}</td>

							</tr>
						{% endfor %}
					</tbody>

				</table>

				{% include "components/pagination.html.twig" with {totalPages: totalPages, pageEnCours: pageEnCours, pathname: 'app_utilisateur_list'} %}

			</section>
		</main>
	</div>


{% endblock %}
