{% extends 'base.html.twig' %}

{% block title %}Gestion des Commandes
{% endblock %}


{% block body %}


	<div class="container">
		{% include 'components/barLaterale.html.twig' %}


		<main class="main-content">
			<header>
				<h2>DashBoard</h2>

				{% include 'components/nomUser.html.twig' %}
			</header>

			<div class="stats-grid">
				<div class="card card-green-border">
					<div class="icon-box green-bg">
						<i class="fa-regular fa-money-bill-1"></i>
					</div>
					<div class="card-info">
						<p>Recette du jour</p>
						<h3>{{ recetteDuJour|number_format(0, ',', ' ') }}
							FCFA</h3>
					</div>
				</div>
				<div class="card card-yellow-border">
					<div class="icon-box yellow-bg">
						<i class="fa-regular fa-clock"></i>
					</div>
					<div class="card-info">
						<p>Termine</p>
						<h3>{{ commandesTerminees }}</h3>
					</div>
				</div>
				<div class="card card-green-light-border">
					<div class="icon-box light-green-bg">
						<i class="fa-solid fa-check"></i>
					</div>
					<div class="card-info">
						<p>Validee</p>
						<h3>{{ commandesValidees }}</h3>
					</div>
				</div>
				<div class="card card-red-border">
					<div class="icon-box red-bg">
						<i class="fa-solid fa-xmark"></i>
					</div>
					<div class="card-info">
						<p>Produit le plus vendu</p>
						<h4>{{ produitPlusVenduDuJour ? produitPlusVenduDuJour.produitNom : 'Aucun' }}</h4>
					</div>
				</div>
			</div>

			<section class="recent-orders">
				<form method="get" action="{{ path('app_commande') }}" class="filter-form">
					<div class="table-header-control">
						<h3>Commandes Recentes</h3>

						<div class="filter-box">
							<select name="etat" onchange="this.form.submit()">
								<option value="">Tous les états</option>
								<option value="VALIDE" {{ filtres.etat == 'VALIDE' ? 'selected' }}>Validée</option>
								<option value="TERMINE" {{ filtres.etat == 'TERMINE' ? 'selected' }}>Terminée</option>
							</select>
							<i class="fa-solid fa-chevron-down"></i>
						</div>

						<div class="filter-box">
							<input type="date" name="date" value="{{ filtres.date }}" onchange="this.form.submit()">
						</div>

						<div class="filter-box">
							<input type="text" name="client" placeholder="Rechercher client..." value="{{ filtres.client }}" onchange="this.form.submit()">
						</div>

						<a href="{{ path('app_commande') }}" class="reset-filter" title="Réinitialiser">
							<i class="fa-solid fa-arrow-rotate-left"></i>
						</a>
					</div>
					<input type="hidden" name="page" value="1">
				</form>

				<table class="styled-table">
					<thead>
						<tr>
							{# <th>Id</th> #}
							<th>Client</th>
							<th>Montant</th>
							<th>Produit</th>
							<th>Date</th>
							<th>Mode</th>
							<th>Etat</th>
							<th>Action</th>
						</tr>
					</thead>
					<tbody>
						{% for commande in commandes %}
							{% if commande.etat != 'EN_COURS' %}
								<tr>
									{# <td>{{ commande.id }}</td> #}

									<td>{{ commande.client.nom }}</td>
									<td>{{ commande.montantTotal }}
										FCFA</td>
									<td>
										<strong>{{ commande.produit.nom }}</strong>
									</td>
									<td>{{ commande.dateCommande|date('d/m/Y') }}</td>
									<td>{% include 'components/afficherModeLivraison.html.twig' with {'modeLivraison': commande.modeLivraison} %}</td>
									<td>
										{% include 'components/statut.html.twig' with {'etat': commande.etat} %}
									</td>
									<td>

										<a href="{{ path('app_commande_show', { id: commande.id, page: pageEnCours }) }}" class="action-icon green-icon">
											<i class="fa-regular fa-eye"></i>
										</a>

									</td>
								</tr>
							{% endif %}
						{% endfor %}
					</tbody>

				</table>

				{% include "components/pagination.html.twig" with {totalPages: totalPages, pageEnCours: pageEnCours, pathname: 'app_commande',params: filtres} %}

			</section>
		</main>
	</div>


{% endblock %}
