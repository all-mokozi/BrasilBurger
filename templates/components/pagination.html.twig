<div class="pagination">
    {% if pageEnCours > 1 %}
    <a class="page-btn" 
       href="{{ path(pathname, app.request.query.all|merge({ page: pageEnCours - 1 })) }}">
        <i class="fa-solid fa-chevron-left"></i>
    </a>
    {% else %}
    <span class="page-btn disabled">
        <i class="fa-solid fa-chevron-left"></i>
    </span>
    {% endif %}

    <span class="page-btn active">{{ pageEnCours }}</span>
    <span class="page-info"> {{ totalPages }}</span>

    {% if pageEnCours < totalPages %}
    <a class="page-btn" 
       href="{{ path(pathname, app.request.query.all|merge({ page: pageEnCours + 1 })) }}">
        <i class="fa-solid fa-chevron-right"></i>
    </a>
    {% else %}
    <span class="page-btn disabled">
        <i class="fa-solid fa-chevron-right"></i>
    </span>
    {% endif %}
</div>
